    <TIER ANNOTATOR="Alina" LINGUISTIC_TYPE_REF="utterance"
        PARTICIPANT="@ddg2008f" TIER_ID="text@ddg2008f">
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a1"
                TIME_SLOT_REF1="ts12" TIME_SLOT_REF2="ts64">
                <ANNOTATION_VALUE>эээ в первую очередь до того как я / э взяла диплом по русскому я хотела поступать не на фундаментальную лингвистику так как она толково преподаётся достаточно в малом количестве ВУЗов куда достаточно сложно попасть на бюджет / поэтому я думала о поступлении на обычную лингвистику в  / МГЛУ или в РГГУ  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a2"
                TIME_SLOT_REF1="ts65" TIME_SLOT_REF2="ts106">
                <ANNOTATION_VALUE>иии / в целом планировала поступать туда но после того как у меня появился диплом я уже начала рассматривать либо МГУ либо  ВШЭ но / как-то так вышло что у меня сразу в голове появилась #нрзб# что я хочу в  ВШЭ</ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a3"
                TIME_SLOT_REF1="ts107" TIME_SLOT_REF2="ts129">
                <ANNOTATION_VALUE>оно как минимум ближе мне к дому потому что до МГУ было бы добираться ещё дольше и в целом вышка ощющается как-то  </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
        <ANNOTATION>
            <ALIGNABLE_ANNOTATION ANNOTATION_ID="a4"
                TIME_SLOT_REF1="ts130" TIME_SLOT_REF2="ts197">
                <ANNOTATION_VALUE>эм / более идущей в ногу со временем возможно я конечно не права / но я подумала что здесь я смогу получить более / э / не только фундаментальные навыки но и прикладные так как в МГУ они кажется всё-таки больше сосредоточены на теоретической части / а в вышке  я смогу себя попробовать в этом в том числе / и поэтому всё-таки выбор  пал в сторону вышки   </ANNOTATION_VALUE>
            </ALIGNABLE_ANNOTATION>
        </ANNOTATION>
    </TIER>
    <TIER ANNOTATOR="Alina" LINGUISTIC_TYPE_REF="utterance"
